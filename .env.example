# Copy to .env.local and fill in. NEVER commit .env.local.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings > API Keys). Both values are safe for the browser:
# the publishable key only works within the Row Level Security rules.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The secret key (sb_secret_...) is NOT used yet. If it is ever needed it must be
# server-only and never prefixed NEXT_PUBLIC_.
